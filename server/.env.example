# Core server settings
EASY_UPLOAD_ADDR=:8080
EASY_UPLOAD_DATABASE_URL=postgres://postgres:postgres@localhost:5432/easy_upload?sslmode=disable
EASY_UPLOAD_AUTH_TOKENS=dev-token
EASY_UPLOAD_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Storage backend selection
EASY_UPLOAD_STORAGE_BACKEND=local
EASY_UPLOAD_LOCAL_ROOT=./data

# Upload and worker limits
EASY_UPLOAD_MAX_UPLOAD_BYTES=5497558138880
EASY_UPLOAD_MAX_CHUNK_BYTES=134217728
EASY_UPLOAD_INACTIVITY_TTL=24h
EASY_UPLOAD_SWEEP_INTERVAL=15m
EASY_UPLOAD_FINALIZE_INTERVAL=5s
EASY_UPLOAD_FINALIZE_LIMIT=100
EASY_UPLOAD_EXPIRE_LIMIT=100

# S3 / R2 settings when EASY_UPLOAD_STORAGE_BACKEND=s3
EASY_UPLOAD_S3_BUCKET=
EASY_UPLOAD_S3_REGION=auto
EASY_UPLOAD_S3_ENDPOINT=
EASY_UPLOAD_S3_ACCESS_KEY=
EASY_UPLOAD_S3_SECRET_KEY=
EASY_UPLOAD_S3_USE_PATH_STYLE=false
